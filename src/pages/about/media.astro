---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import { buildBaseGraph, toGraph } from '../../lib/seo-graph';

const description = 'External media appearances by Graham Wright, including the 2012–2015 Opus Affair years on WBUR Radio Boston.';
const graph = toGraph([
  ...buildBaseGraph(),
]);

const radioBoston = [
  { date: '2012-04-05', label: 'April 5, 2012', title: "Weekend Picks: Little Match Girl Edition", url: 'https://www.wbur.org/radioboston/2012/04/05/weekend-picks-12' },
  { date: '2012-05-03', label: 'May 3, 2012', title: 'Weekend Picks: Ballet, Contemporary Music and Visual Art', url: 'https://www.wbur.org/radioboston/2012/05/03/weekend-picks-14' },
  { date: '2012-05-24', label: 'May 24, 2012', title: 'Weekend Picks: Roller Skating Musical, Film History, Bar', url: 'https://www.wbur.org/radioboston/2012/05/24/weekend-picks-16' },
  { date: '2012-06-21', label: 'June 21, 2012', title: 'Weekend Picks: After Hours at the Gardner', url: 'https://www.wbur.org/radioboston/2012/06/21/weekend-picks-17' },
  { date: '2012-09-13', label: 'September 13, 2012', title: 'Weekend Picks: The Mikado, the Aquarium, and Opera', url: 'https://www.wbur.org/radioboston/2012/09/13/picks-mikado-aquarium-opera' },
  { date: '2013-02-01', label: 'February 1, 2013', title: "The Boston Symphony Orchestra's Cello 'Boy Band'", url: 'https://www.wbur.org/radioboston/2013/02/01/boston-cello-quartet' },
  { date: '2013-02-07', label: 'February 7, 2013', title: "The Boston Lyric Opera's Clemency", url: 'https://www.wbur.org/radioboston/2013/02/07/clemency' },
  { date: '2013-06-06', label: 'June 6, 2013', title: 'Classical Music Fans, Take Note: Rachmaninoff Wrote Operas', url: 'https://www.wbur.org/radioboston/2013/06/06/opera-2' },
  { date: '2013-09-12', label: 'September 12, 2013', title: 'ARTery: Odyssey Opera Takes On Rienzi', url: 'https://www.wbur.org/radioboston/2013/09/12/artery-rienzi' },
  { date: '2013-09-13', label: 'September 13, 2013', title: 'With a Bold Choice, Boston Upstart Steps Into the Risky Opera Business', url: 'https://www.wbur.org/news/2013/09/13/odyssey-opera-rienzi' },
  { date: '2013-11-21', label: 'November 21, 2013', title: 'ARTery: Our Very Own Voigt Lesson', url: 'https://www.wbur.org/radioboston/2013/11/21/voigt' },
  { date: '2014-01-10', label: 'January 10, 2014', title: 'ARTery: A Far Cry and Urbanity Dance Have Chemistry', url: 'https://www.wbur.org/radioboston/2014/01/10/artery-chemistry' },
  { date: '2014-09-08', label: 'September 8, 2014', title: "ARTery: Boston Opera Lovers Gather at OBERON's #iamopera", url: 'https://www.wbur.org/radioboston/2014/09/08/artery-boston-opera-lovers-gather-at-oberons-iamopera' },
  { date: '2015-06-19', label: 'June 19, 2015', title: 'Roller-Disco Party to Celebrate Donna Summer', url: 'https://www.wbur.org/radioboston/2015/06/19/donna-summer-roller-disco-2' },
  { date: '2015-12-01', label: 'December 1, 2015', title: "Boston's Changing Theater Scene", url: 'https://www.wbur.org/radioboston/2015/12/01/bostons-theater' },
];
---

<Base title="Media" description={description} graph={graph}>
  <Prose>
    <p class="font-(family-name:--font-ui) uppercase tracking-widest text-(--color-muted) text-xs">About</p>
    <h1>Media</h1>

    <h2>WBUR Radio Boston (2012–2015)</h2>
    <p>Guest appearances on WBUR's <em>Radio Boston</em> as founder and host of <a href="https://opusaffair.org/">Opus Affair</a>.</p>
    <ul>
      {radioBoston.map(item => (
        <li>
          <a href={item.url}>{item.title}</a>
          <span class="text-(--color-muted)"> — <time datetime={item.date}>{item.label}</time></span>
        </li>
      ))}
    </ul>
  </Prose>
</Base>
