---
import VideoIsland from './VideoIsland.tsx';

interface Props {
  src: string;
  title: string;
  caption?: string;
  credit?: string;
  aspectRatio?: string;
  poster?: string;
  size?: 'standard' | 'wide' | 'full' | 'small';
  /** Plain-text description for VideoObject schema. Required for Google video rich results. */
  description?: string;
  /** ISO 8601 date the video was uploaded/published (e.g. "2026-04-20"). Required for Google video rich results. */
  uploadDate?: string;
}

const {
  src,
  title,
  caption,
  credit,
  aspectRatio = '16/9',
  poster,
  size = 'standard',
  description,
  uploadDate,
} = Astro.props;

const videoSchema: Record<string, string> = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  contentUrl: src,
};
if (description) videoSchema.description = description;
if (poster) videoSchema.thumbnailUrl = poster;
if (uploadDate) videoSchema.uploadDate = uploadDate;

// Video.js v10 (beta, GA targeted mid-2026). Pinned to 10.0.0-beta.23 — no
// caret. Watch the changelog at each minor bump; v9 is the team's escape
// valve for breaking changes pre-GA. Player lives in VideoIsland.tsx.
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
<figure class:list={[size !== 'standard' && size]}>
  <div class="video-wrapper" style={`aspect-ratio: ${aspectRatio};`}>
    <VideoIsland client:only="react" src={src} poster={poster} title={title} />
  </div>
  {(caption || credit) && (
    <figcaption>
      {caption && <Fragment set:html={caption} />}
      {credit && <span class="figure-credit"><Fragment set:html={credit} /></span>}
    </figcaption>
  )}
</figure>

<style>
  .video-wrapper {
    border-radius: 8px;
    overflow: hidden;
    background: #000;
    position: relative;
  }
</style>
